# Copy to .env and adjust for your environment. Never commit a real .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=etl_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://etl_user:change_me@localhost:5432/etl_db

# Input data
DATA_DIR=data/sample
ORDERS_FILE=data/sample/orders.csv

# Quality thresholds
MAX_ORDER_AGE_DAYS=365
MIN_ROWS_EXPECTED=1

# Logging
LOG_LEVEL=INFO
